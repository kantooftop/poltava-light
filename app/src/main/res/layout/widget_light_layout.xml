<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Queue, Status, Refresh Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_queue_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Черга 6.1"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Divider replaced with ImageView for RemoteViews compatibility -->
            <ImageView
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_divider" />

            <!-- Status Dot -->
            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot_on" />

            <!-- Status Text -->
            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Світло є"
                android:textColor="#00D180"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Refresh Button -->
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="@string/refresh"
            android:padding="6dp"
            android:src="@drawable/ic_refresh_widget" />
    </RelativeLayout>

    <!-- Center Hero Section: Big Countdown / Change Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Світло є"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Зміна о 14:30 • через 1 год 29 хв"
            android:textColor="#8E8E93"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Row: Next Events & Sync Time -->
    <LinearLayout
        android:id="@+id/widget_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_events"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Далі: 14:30 Перемикання • 15:00 Світло"
            android:textColor="#8E8E93"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_updated_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Оновлено: 14:30"
            android:textColor="#636366"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

